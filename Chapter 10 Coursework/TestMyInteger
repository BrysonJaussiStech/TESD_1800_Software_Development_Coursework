public class TestMyInteger {
    public static void main(String[] args) {
        MyInteger n1 = new MyInteger(17);
        MyInteger n2 = new MyInteger(24);
        System.out.println("Object Initialization:");
        System.out.println("n1 value: " + n1.getValue());
        System.out.println("n2 value: " + n2.getValue());
        System.out.println();

        System.out.println("Testing Instance Methods:");
        System.out.printf("n1 (%d) -> isEven: %b, isOdd: %b, isPrime: %b\n", 
                n1.getValue(), n1.isEven(), n1.isOdd(), n1.isPrime());
        System.out.printf("n2 (%d) -> isEven: %b, isOdd: %b, isPrime: %b\n", 
                n2.getValue(), n2.isEven(), n2.isOdd(), n2.isPrime());
        System.out.println();

        System.out.println("Testing Static Methods (int):");
        System.out.printf("int 9 -> isEven: %b, isOdd: %b, isPrime: %b\n", 
                MyInteger.isEven(9), MyInteger.isOdd(9), MyInteger.isPrime(9));
        System.out.printf("int 2 -> isEven: %b, isOdd: %b, isPrime: %b\n", 
                MyInteger.isEven(2), MyInteger.isOdd(2), MyInteger.isPrime(2));
        System.out.println();

        System.out.println("Testing Static Methods (MyInteger):");
        System.out.printf("MyInteger n1 -> isEven: %b, isOdd: %b, isPrime: %b\n", 
                MyInteger.isEven(n1), MyInteger.isOdd(n1), MyInteger.isPrime(n1));
        System.out.println();

        System.out.println("Testing Equals Methods:");
        System.out.println("n1 equals primitive 17? " + n1.equals(17));
        System.out.println("n1 equals primitive 24? " + n1.equals(24));
        System.out.println("n1 equals object n2? " + n1.equals(n2));
        
        MyInteger n3 = new MyInteger(17);
        System.out.println("n1 equals object n3 (value 17)? " + n1.equals(n3));
        System.out.println();

        System.out.println("Testing parseInt Methods:");
        char[] charArray = {'4', '3', '2', '1'};
        int parsedChar = MyInteger.parseInt(charArray);
        System.out.println("Parsed char[] {'4','3','2','1'}: " + parsedChar);

        String strArray = "9876";
        int parsedString = MyInteger.parseInt(strArray);
        System.out.println("Parsed String \"9876\": " + parsedString);
    }
}

class MyInteger {
    private final int value;

    public MyInteger(int value) {
        this.value = value;
    }

    public int getValue() {
        return value;
    }

    public boolean isEven() {
        return isEven(this.value);
    }

    public boolean isOdd() {
        return isOdd(this.value);
    }

    public boolean isPrime() {
        return isPrime(this.value);
    }

    public static boolean isEven(int value) {
        return value % 2 == 0;
    }

    public static boolean isOdd(int value) {
        return value % 2 != 0;
    }

    public static boolean isPrime(int value) {
        if (value <= 1) {
            return false;
        }
        for (int i = 2; i <= Math.sqrt(value); i++) {
            if (value % i == 0) {
                return false;
            }
        }
        return true;
    }

    public static boolean isEven(MyInteger myInt) {
        return isEven(myInt.getValue());
    }

    public static boolean isOdd(MyInteger myInt) {
        return isOdd(myInt.getValue());
    }

    public static boolean isPrime(MyInteger myInt) {
        return isPrime(myInt.getValue());
    }

    public boolean equals(int value) {
        return this.value == value;
    }

    public boolean equals(MyInteger myInt) {
        return this.value == myInt.getValue();
    }

    public static int parseInt(char[] chars) {
        return parseInt(new String(chars));
    }

    public static int parseInt(String str) {
        return Integer.parseInt(str);
    }
}
